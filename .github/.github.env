# github specific
EC2_INSTANCE_TYPE=t3.large
RUNNER_SIZE=large

# App related
APP_NAME=agent-mandate-hack
REPO=agent-mandate-hack
VERSION=v1

# ECR Repo Name (comma seperated values)
DOCKER_BUILD_INSTANCE=agent-mandate-hack

ECR_REPO=agent-mandate-hack-backend,agent-mandate-hack-frontend 
SERVICE=frontend,backend
.vscode/*